{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/product"
    }
  ],
  "redirects": [
    {
      "source": "/r/:code",
      "destination": "/?ref=:code",
      "statusCode": 302
    },
    {
      "source": "/product",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/product/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026",
      "destination": "/product-2026",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/",
      "destination": "/product-2026/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/:path*",
      "destination": "/product-2026/:path*",
      "statusCode": 301
    }
  ]
}
