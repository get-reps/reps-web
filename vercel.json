{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/deck-followup",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/echo-set",
      "destination": "/api/echo-set"
    },
    {
      "source": "/",
      "destination": "/cs-c-lora"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/resolve?slug=:slug"
    },
    {
      "source": "/i/:path*",
      "destination": "/invite"
    },
    {
      "source": "/mcp",
      "destination": "https://vciosaulrfvddcenblmo.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://vciosaulrfvddcenblmo.supabase.co/functions/v1/mcp/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://vciosaulrfvddcenblmo.supabase.co/functions/v1/mcp/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://vciosaulrfvddcenblmo.supabase.co/functions/v1/mcp/oauth-protected-resource"
    }
  ],
  "redirects": [
    {
      "source": "/i/:code",
      "destination": "/invite?code=:code",
      "permanent": false
    },
    {
      "source": "/play/verbatim",
      "destination": "/play/quotle",
      "statusCode": 301
    },
    {
      "source": "/play/verbatim/",
      "destination": "/play/quotle",
      "statusCode": 301
    },
    {
      "source": "/product",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/product/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026",
      "destination": "/product-2026",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/",
      "destination": "/product-2026/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/:path*",
      "destination": "/product-2026/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "<https://www.getreps.io/home.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
