{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/deck-followup",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/echo-set",
      "destination": "/api/echo-set"
    },
    {
      "source": "/",
      "destination": "/cs-c-lora"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/resolve?slug=:slug"
    },
    {
      "source": "/i/:path*",
      "destination": "/invite"
    }
  ],
  "redirects": [
    {
      "source": "/i/:code",
      "destination": "/invite?code=:code",
      "permanent": false
    },
    {
      "source": "/play/verbatim",
      "destination": "/play/quotle",
      "statusCode": 301
    },
    {
      "source": "/play/verbatim/",
      "destination": "/play/quotle",
      "statusCode": 301
    },
    {
      "source": "/product",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/product/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026",
      "destination": "/product-2026",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/",
      "destination": "/product-2026/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/:path*",
      "destination": "/product-2026/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "<https://www.getreps.io/index.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        { "key": "Link", "value": "<https://www.getreps.io/blog.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/planet",
      "headers": [
        { "key": "Link", "value": "<https://www.getreps.io/planet.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/about",
      "headers": [
        { "key": "Link", "value": "<https://www.getreps.io/about.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
