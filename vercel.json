{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/v3c"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/resolve?slug=:slug"
    },
    {
      "source": "/i/:code",
      "destination": "/invite.html?code=:code"
    }
  ],
  "redirects": [
    {
      "source": "/product",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/product/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026",
      "destination": "/product-2026",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/",
      "destination": "/product-2026/",
      "statusCode": 301
    },
    {
      "source": "/investor-2026/:path*",
      "destination": "/product-2026/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
