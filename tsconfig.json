{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    // The test harness runs the TypeScript directly (`tsx --test`), so its imports
    // carry the real `.ts` extension. Safe here because nothing is ever emitted.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["api/**/*.ts", "api/**/*.d.ts"]
}
